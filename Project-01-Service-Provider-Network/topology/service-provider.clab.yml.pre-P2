name: sp-routing-lab

mgmt:
  network: sp-routing-mgmt
  ipv4-subnet: 10.250.250.0/24

topology:
  nodes:
    P1:
      kind: linux
      image: quay.io/frrouting/frr:10.3.1
      binds:
        - /home/installer/Network-Engineering-Portfolio/Project-01-Service-Provider-Network/configs/P1/daemons:/etc/frr/daemons
        - /home/installer/Network-Engineering-Portfolio/Project-01-Service-Provider-Network/configs/P1/frr.conf:/etc/frr/frr.conf
        - /home/installer/Network-Engineering-Portfolio/Project-01-Service-Provider-Network/configs/P1/vtysh.conf:/etc/frr/vtysh.conf
      cap-add:
        - NET_ADMIN
        - SYS_ADMIN
      sysctls:
        net.ipv4.ip_forward: 1
